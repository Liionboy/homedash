# Homedash — Environment Variables
# Copy this file to .env and edit:
#   cp .env.example .env

# ── Server ──
HOMEDASH_PORT=9876

# ── Authentication ──
HOMEDASH_USER=admin
HOMEDASH_PASS=replace-with-a-strong-password-at-least-12-chars
HOMEDASH_SECRET=replace-with-openssl-rand-hex-32

# Cookie/TLS settings
HOMEDASH_SECURE_COOKIES=false
# Keep true when services use trusted certificates. For self-signed Proxmox
# certificates, prefer HOMEDASH_CA_BUNDLE over disabling verification.
HOMEDASH_TLS_VERIFY=true
# HOMEDASH_CA_BUNDLE=/app/certs/proxmox-ca.pem

# Persistent database path inside the container
HOMEDASH_DB=/app/data/homedash.db
